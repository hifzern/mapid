# Server-only Supabase REST access. The anon key can execute aggregate RPCs only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# MAPID raster tile template. Use the exact template and attribution supplied by MAPID.
NEXT_PUBLIC_MAPID_TILE_URL=
NEXT_PUBLIC_MAPID_ATTRIBUTION="MAPID MAPS"

# Server-only road router. Use a managed/self-hosted instance and bus profile in production.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving

# Optional network walking isochrones. Without this key, PostGIS uses an
# explicitly labelled 500 m radial fallback around each derived stop.
ISOCHRONE_BASE_URL=https://api.openrouteservice.org
ISOCHRONE_API_KEY=
ISOCHRONE_PROFILE=foot-walking

# Private Next.js -> FastAPI connection.
# Optional on Vercel: the Next.js route returns a deterministic template when
# the separate AI service is not configured or temporarily unavailable.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=replace-with-a-long-random-value

# FastAPI only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
